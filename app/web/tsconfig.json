{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  // shadcn CLI reads the ROOT tsconfig to resolve path aliases, not
  // tsconfig.app.json. Without this it treats "@/components" as a literal
  // directory and writes components to ./@/components/ui.
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
